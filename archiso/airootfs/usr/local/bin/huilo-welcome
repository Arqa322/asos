#!/usr/bin/env bash
# Greeting notification shown at Hyprland start
sleep 2
if grep -q archisobasedir /proc/cmdline; then
	notify-send -a Huilo -t 15000 "Добро пожаловать в Huilo (live)" \
"Пользователь: huilo / пароль: huilo
SUPER+Enter — терминал, SUPER+D — приложения
SUPER+Z — zapret, SUPER+F1 — горячие клавиши
SUPER+A — Arduino IDE, SUPER+Shift+N — NanoPi
Установка на диск: sudo huilo-install"
else
	[[ -f ~/.cache/huilo-welcome-shown ]] && exit 0
	mkdir -p ~/.cache && touch ~/.cache/huilo-welcome-shown
	notify-send -a Huilo -t 15000 "Добро пожаловать в Huilo" \
"SUPER+D — приложения, SUPER+Z — zapret, SUPER+F1 — горячие клавиши"
fi
