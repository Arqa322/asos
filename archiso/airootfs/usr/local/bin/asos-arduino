#!/usr/bin/env bash
# ============================================================================
#  asos-arduino — Arduino / ESP / RP2040 / STM32 helper for ASOS
#
#  Wraps arduino-cli: diagnostics, board/port auto-detection, build, upload,
#  serial monitor, installing extra cores. Sketches live in ~/Arduino and use
#  the same cores/libraries as Arduino IDE 2 (~/.arduino15).
# ============================================================================
set -euo pipefail

SKETCHBOOK="${ARDUINO_SKETCHBOOK:-$HOME/Arduino}"
BAUD_DEFAULT=115200

c_ok=$'\e[32m'; c_warn=$'\e[33m'; c_err=$'\e[31m'; c_b=$'\e[1m'; c_dim=$'\e[2m'; c_0=$'\e[0m'
[[ -t 1 ]] || { c_ok=; c_warn=; c_err=; c_b=; c_dim=; c_0=; }
die()  { echo "${c_err}error:${c_0} $*" >&2; exit 1; }
info() { echo "${c_ok}::${c_0} $*"; }
ok()   { echo "  ${c_ok}✔${c_0} $*"; }
warn() { echo "  ${c_warn}!${c_0} $*"; }
bad()  { echo "  ${c_err}✘${c_0} $*"; }

need_cli() { command -v arduino-cli >/dev/null || die "arduino-cli is not installed (sudo pacman -S arduino-cli)"; }

# platform id -> human name
declare -A CORE_NAME=(
	[arduino:avr]="Arduino AVR (Uno, Nano, Mega, Leonardo, Pro Mini)"
	[arduino:megaavr]="Arduino megaAVR (Nano Every, Uno WiFi Rev2)"
	[arduino:renesas_uno]="Arduino UNO R4 Minima / WiFi"
	[arduino:sam]="Arduino Due"
	[arduino:mbed_nano]="Arduino Nano 33 BLE / RP2040 Connect"
	[esp32:esp32]="Espressif ESP32 / S2 / S3 / C3 / C6"
	[esp8266:esp8266]="ESP8266 (NodeMCU, Wemos D1 mini)"
	[rp2040:rp2040]="Raspberry Pi Pico / Pico 2 (RP2040/RP2350)"
	[STMicroelectronics:stm32]="STM32 (Blue Pill, Black Pill, Nucleo)"
)
declare -A CORE_ALIAS=(
	[avr]=arduino:avr [megaavr]=arduino:megaavr [r4]=arduino:renesas_uno [due]=arduino:sam
	[nano33]=arduino:mbed_nano [esp32]=esp32:esp32 [esp8266]=esp8266:esp8266
	[rp2040]=rp2040:rp2040 [pico]=rp2040:rp2040 [stm32]=STMicroelectronics:stm32
)

# USB VID:PID -> description / suggested FQBN for boards that are not
# recognised by arduino-cli (clones with USB-UART bridges)
usb_hint() {
	case "$1" in
		1a86:7523|1a86:5523) echo "CH340 USB-UART (клон Nano/Uno, ESP8266) | arduino:avr:nano:cpu=atmega328old" ;;
		1a86:55d4|1a86:55d3) echo "CH9102/CH343 USB-UART (ESP32 DevKit) | esp32:esp32:esp32" ;;
		10c4:ea60) echo "CP2102/CP2104 USB-UART (ESP32/ESP8266 DevKit, NodeMCU) | esp32:esp32:esp32" ;;
		0403:6001|0403:6015) echo "FTDI FT232 USB-UART (Pro Mini, клоны) | arduino:avr:pro" ;;
		067b:2303) echo "Prolific PL2303 USB-UART |" ;;
		303a:*) echo "Espressif native USB (ESP32-S2/S3/C3/C6) | esp32:esp32:esp32s3" ;;
		2e8a:*) echo "Raspberry Pi RP2040/RP2350 | rp2040:rp2040:rpipico" ;;
		0483:3748|0483:374b|0483:374e|0483:3752|0483:3753) echo "ST-Link programmer |" ;;
		0483:df11) echo "STM32 in DFU mode |" ;;
		*) echo "" ;;
	esac
}

# ------------------------------------------------------------ detection ---
# Prints: port US fqbn US name US vid:pid   (US = \x1f, a non-whitespace separator so
# that empty fields survive `read`; fqbn/name are empty for unknown clones)
US=$'\x1f'
detect() {
	need_cli
	arduino-cli board list --format json 2>/dev/null | jq -r '
		(if type == "object" then (.detected_ports // []) else . end)[]
		| select(.port.protocol == "serial" and (.port.properties.vid // "") != "")
		| [ .port.address,
		    ((.matching_boards // .boards // [])[0].fqbn // ""),
		    ((.matching_boards // .boards // [])[0].name // ""),
		    ((.port.properties.vid // "") | sub("^0x"; "") | ascii_downcase) + ":" +
		    ((.port.properties.pid // "") | sub("^0x"; "") | ascii_downcase) ]
		| join("\u001f")' 2>/dev/null || true
}

boards() {
	local port fqbn name vidpid hint any=0
	echo "${c_b}Подключённые платы:${c_0}"
	while IFS=$US read -r port fqbn name vidpid; do
		[[ -n "$port" ]] || continue
		any=1
		if [[ -n "$fqbn" ]]; then
			printf '  %-14s %-36s %s\n' "$port" "$fqbn" "$name"
		else
			hint=$(usb_hint "$vidpid")
			printf '  %-14s %-36s %s\n' "$port" "${hint##*| }" "${c_dim}${hint%% |*} [$vidpid] (определено по USB)${c_0}"
		fi
	done < <(detect)
	[[ $any == 1 ]] || echo "  ${c_dim}нет — подключите плату USB-кабелем с линиями данных${c_0}"
}

# pick port/fqbn: explicit > sketch.yaml defaults > autodetect
resolve_target() { # sets PORT FQBN
	local sketch=$1 p f n v hint=""
	if [[ -z "${FQBN:-}" || -z "${PORT:-}" ]] && [[ -f "$sketch/sketch.yaml" ]]; then
		[[ -n "${FQBN:-}" ]] || FQBN=$(sed -n 's/^default_fqbn:[[:space:]]*//p' "$sketch/sketch.yaml" | tr -d '"' | head -n1)
		[[ -n "${PORT:-}" ]] || PORT=$(sed -n 's/^default_port:[[:space:]]*//p' "$sketch/sketch.yaml" | tr -d '"' | head -n1)
		[[ -n "$PORT" && ! -e "$PORT" ]] && PORT=""
	fi
	if [[ -z "${PORT:-}" || -z "${FQBN:-}" ]]; then
		while IFS=$US read -r p f n v; do
			[[ -n "$p" ]] || continue
			if [[ -z "${PORT:-}" ]]; then PORT=$p; elif [[ "$p" != "$PORT" ]]; then continue; fi
			if [[ -z "${FQBN:-}" ]]; then
				if [[ -n "$f" ]]; then
					FQBN=$f
					info "найдена плата: $n ($FQBN) на $PORT"
				else
					hint=$(usb_hint "$v"); FQBN=${hint##*| }
					if [[ -n "$FQBN" ]]; then
						info "плата не опознана, по USB ($v, ${hint%% |*}) предполагаю $FQBN — другая? укажите -b FQBN"
					fi
				fi
			fi
			break
		done < <(detect)
	fi
}

sketch_dir() {
	local s=${1:-.}
	[[ -d "$s" ]] || s="$SKETCHBOOK/$s"
	[[ -d "$s" ]] || die "скетч '$1' не найден (ни в текущем каталоге, ни в $SKETCHBOOK)"
	s=$(realpath "$s")
	compgen -G "$s/*.ino" >/dev/null || die "$s не похож на скетч Arduino (нет *.ino)"
	printf '%s' "$s"
}

parse_opts() { # -b FQBN -p PORT -B BAUD ; leaves positional in ARGS
	FQBN=${FQBN:-}; PORT=${PORT:-}; BAUD=${BAUD:-$BAUD_DEFAULT}; ARGS=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-b|--fqbn) FQBN=$2; shift 2 ;;
			-p|--port) PORT=$2; shift 2 ;;
			-B|--baud) BAUD=$2; shift 2 ;;
			*) ARGS+=("$1"); shift ;;
		esac
	done
}

# -------------------------------------------------------------- actions ---
cmd_build() {
	need_cli; parse_opts "$@"
	local s; s=$(sketch_dir "${ARGS[0]:-.}")
	resolve_target "$s"
	[[ -n "$FQBN" ]] || die "не удалось определить плату — укажите -b FQBN (см. asos-arduino fqbn)"
	info "сборка $s для $FQBN"
	arduino-cli compile --fqbn "$FQBN" --warnings default "$s"
}

cmd_upload() {
	need_cli; parse_opts "$@"
	local s; s=$(sketch_dir "${ARGS[0]:-.}")
	resolve_target "$s"
	[[ -n "$PORT" ]] || die "плата не найдена — подключите её или укажите -p /dev/ttyUSB0"
	[[ -n "$FQBN" ]] || die "не удалось определить плату — укажите -b FQBN (см. asos-arduino fqbn)"
	[[ -w "$PORT" ]] || die "нет доступа к $PORT — выполните: asos-arduino doctor"
	info "сборка и загрузка $s → $FQBN @ $PORT"
	arduino-cli compile --fqbn "$FQBN" --upload --port "$PORT" "$s"
	# remember the board for this sketch (sketch.yaml)
	arduino-cli board attach --port "$PORT" --fqbn "$FQBN" "$s" >/dev/null 2>&1 || true
	ok "готово"
}

cmd_monitor() {
	need_cli; parse_opts "$@"
	if [[ -z "$PORT" ]]; then
		PORT=$(detect | head -n1 | cut -d"$US" -f1)
		[[ -n "$PORT" ]] || die "плата не найдена — укажите -p PORT"
	fi
	info "монитор порта $PORT @ $BAUD (выход: Ctrl+C)"
	arduino-cli monitor --port "$PORT" --config "baudrate=$BAUD"
}

cmd_new() {
	need_cli
	local name=${1:?usage: asos-arduino new <name>}
	mkdir -p "$SKETCHBOOK"
	arduino-cli sketch new "$SKETCHBOOK/$name"
	info "создан $SKETCHBOOK/$name/$name.ino"
}

cmd_setup() {
	need_cli
	local -a want=() a
	[[ $# -gt 0 ]] || set -- help
	for a in "$@"; do
		case "$a" in
			all) want+=(arduino:avr arduino:megaavr arduino:renesas_uno esp32:esp32 esp8266:esp8266 rp2040:rp2040 STMicroelectronics:stm32) ;;
			help|-h|--help)
				echo "usage: asos-arduino setup <core...>"
				for k in "${!CORE_ALIAS[@]}"; do printf '  %-9s %-28s %s\n' "$k" "${CORE_ALIAS[$k]}" "${CORE_NAME[${CORE_ALIAS[$k]}]}"; done | sort
				echo "  all       всё перечисленное (несколько ГБ!)"
				return 0 ;;
			*:*) want+=("$a") ;;
			*) [[ -n "${CORE_ALIAS[$a]:-}" ]] || die "неизвестное ядро '$a' (asos-arduino setup help)"; want+=("${CORE_ALIAS[$a]}") ;;
		esac
	done
	info "обновление индексов плат"
	arduino-cli core update-index
	for a in "${want[@]}"; do
		info "установка $a — ${CORE_NAME[$a]:-}"
		arduino-cli core install "$a" || warn "не удалось установить $a"
	done
}

cmd_fqbn() {
	need_cli
	local filter=${1:-}
	arduino-cli board listall ${filter:+"$filter"}
}

cmd_doctor() {
	local u g port grp ok_group=0 any
	u=$(id -un)
	echo "${c_b}ASOS Arduino doctor${c_0}"

	echo "${c_b}Программы${c_0}"
	if command -v arduino-cli >/dev/null; then ok "arduino-cli $(arduino-cli version --format json 2>/dev/null | jq -r '.VersionString // empty' || true)"; else bad "arduino-cli не установлен"; fi
	if command -v arduino-ide >/dev/null; then ok "Arduino IDE 2 (arduino-ide)"; else warn "Arduino IDE 2 не установлена (yay -S arduino-ide-bin)"; fi
	command -v pio >/dev/null && ok "PlatformIO Core (pio)"
	command -v esptool >/dev/null && ok "esptool"
	command -v avrdude >/dev/null && ok "avrdude"

	echo "${c_b}Доступ к портам${c_0}"
	if getent group uucp | cut -d: -f4 | tr ',' '\n' | grep -qx "$u"; then
		if id -nG | tr ' ' '\n' | grep -qx uucp; then ok "пользователь $u в группе uucp"; ok_group=1
		else warn "$u добавлен в uucp, но нужно перезайти в систему (или выполнить: newgrp uucp)"; fi
	else
		bad "пользователь $u не в группе uucp — исправить: sudo usermod -aG uucp $u  (и перезайти)"
	fi

	echo "${c_b}Ядра (платформы)${c_0}"
	if command -v arduino-cli >/dev/null; then
		any=0
		while read -r id inst _; do
			[[ "$id" == ID || -z "$id" ]] && continue
			ok "$id $inst ${c_dim}${CORE_NAME[$id]:-}${c_0}"; any=1
		done < <(arduino-cli core list 2>/dev/null)
		[[ $any == 1 ]] || warn "ядра не установлены — asos-arduino setup avr"
	fi

	echo "${c_b}USB-устройства${c_0}"
	any=0
	for port in /dev/ttyACM* /dev/ttyUSB*; do
		[[ -e "$port" ]] || continue
		any=1
		grp=$(stat -c %G "$port")
		local props vid pid drv model
		props=$(udevadm info -q property -n "$port" 2>/dev/null || true)
		vid=$(sed -n 's/^ID_VENDOR_ID=//p' <<<"$props"); pid=$(sed -n 's/^ID_MODEL_ID=//p' <<<"$props")
		drv=$(sed -n 's/^ID_USB_DRIVER=//p' <<<"$props"); model=$(sed -n 's/^ID_MODEL_FROM_DATABASE=//p;s/^ID_MODEL=//p' <<<"$props" | head -n1)
		if [[ -r "$port" && -w "$port" ]]; then
			ok "$port  $vid:$pid  ${drv:-?}  ${model:-} ${c_dim}(группа $grp)${c_0}"
		else
			bad "$port  $vid:$pid  ${drv:-?}  ${model:-} — нет доступа (группа $grp)"
		fi
		local hint sug; hint=$(usb_hint "$vid:$pid")
		if [[ -n "$hint" ]]; then
			sug=${hint##*| }
			echo "      ${c_dim}${hint%% |*}${sug:+ → FQBN $sug}${c_0}"
		fi
	done
	[[ $any == 1 ]] || {
		warn "последовательные порты не найдены"
		echo "      ${c_dim}• кабель только для зарядки? попробуйте другой"
		echo "      • ESP32-S3/C3 с native USB: удерживайте BOOT при подключении"
		echo "      • lsusb покажет, видит ли система устройство вообще${c_0}"
		lsusb 2>/dev/null | grep -v -i 'hub' | sed 's/^/      /' || true
	}
	lsmod 2>/dev/null | awk '$1 ~ /^(ch341|cp210x|ftdi_sio|pl2303|cdc_acm)$/ {printf "  · драйвер %s загружен\n", $1}'

	echo "${c_b}Прочее${c_0}"
	if systemctl is-active --quiet ModemManager 2>/dev/null; then
		ok "ModemManager игнорирует Arduino/USB-UART (правила /etc/udev/rules.d/70-asos-embedded.rules)"
	fi
	if curl -s -m 5 -o /dev/null https://downloads.arduino.cc; then ok "доступ к downloads.arduino.cc"; else warn "нет доступа к downloads.arduino.cc — установка ядер/библиотек не сработает"; fi
	[[ $ok_group == 1 ]] || return 1
}

cmd_menu() {
	command -v dialog >/dev/null || die "dialog is not installed"
	local c s
	while true; do
		c=$(dialog --stdout --title "ASOS Arduino" --menu "Arduino / ESP / RP2040 / STM32" 20 72 12 \
			ide "Открыть Arduino IDE 2" \
			doctor "Диагностика (порты, группы, драйверы)" \
			boards "Показать подключённые платы" \
			upload "Собрать и загрузить скетч" \
			monitor "Монитор порта" \
			new "Новый скетч" \
			setup "Установить ядра (ESP32, ESP8266, RP2040, STM32...)" \
			example "Пример: мост Arduino ↔ NanoPi" \
			quit "Выход") || break
		clear
		case "$c" in
			ide) (setsid arduino-ide >/dev/null 2>&1 &) ;;
			doctor) cmd_doctor || true; read -rp "Enter..." _ ;;
			boards) boards; read -rp "Enter..." _ ;;
			upload)
				s=$(dialog --stdout --dselect "$SKETCHBOOK/" 14 70) && { cmd_upload "${s%/}" || true; read -rp "Enter..." _; } ;;
			monitor) cmd_monitor || true ;;
			new) s=$(dialog --stdout --inputbox "Имя скетча:" 8 50) && [[ -n "$s" ]] && { cmd_new "$s"; read -rp "Enter..." _; } ;;
			setup)
				s=$(dialog --stdout --checklist "Ядра для установки (нужен интернет)" 18 76 9 \
					esp32 "${CORE_NAME[esp32:esp32]}" off esp8266 "${CORE_NAME[esp8266:esp8266]}" off \
					rp2040 "${CORE_NAME[rp2040:rp2040]}" off stm32 "${CORE_NAME[STMicroelectronics:stm32]}" off \
					megaavr "${CORE_NAME[arduino:megaavr]}" off r4 "${CORE_NAME[arduino:renesas_uno]}" off \
					nano33 "${CORE_NAME[arduino:mbed_nano]}" off due "${CORE_NAME[arduino:sam]}" off \
					avr "${CORE_NAME[arduino:avr]}" off) && [[ -n "$s" ]] && {
					# shellcheck disable=SC2086
					cmd_setup $s || true; read -rp "Enter..." _; } ;;
			example) "${PAGER:-less}" /usr/share/asos/embedded/examples/README.md ;;
			quit) break ;;
		esac
	done
	clear
}

usage() {
	cat <<EOF
${c_b}asos-arduino${c_0} — Arduino / ESP32 / ESP8266 / RP2040 / STM32 helper

  menu                         интерактивное меню
  doctor                       диагностика: группа uucp, порты, драйверы, ядра
  boards                       подключённые платы (порт + FQBN)
  new <name>                   новый скетч в $SKETCHBOOK
  build  [sketch] [-b FQBN]    компиляция
  upload [sketch] [-b FQBN] [-p PORT]
                               компиляция + загрузка (плата/порт определяются
                               сами и запоминаются в sketch.yaml)
  monitor [-p PORT] [-B BAUD]  монитор порта (по умолчанию $BAUD_DEFAULT)
  setup <esp32|esp8266|rp2040|stm32|avr|megaavr|r4|nano33|due|all>
                               установить ядра плат (нужен интернет)
  fqbn [filter]                список всех плат и их FQBN
  ide                          запустить Arduino IDE 2

Примеры:
  asos-arduino upload Blink
  asos-arduino upload ~/Arduino/AsosSerialBridge -b arduino:avr:nano:cpu=atmega328old
  asos-arduino monitor -B 9600
EOF
}

cmd=${1:-menu}; shift || true
case "$cmd" in
	menu) cmd_menu ;;
	doctor) cmd_doctor ;;
	boards|list|ports) boards ;;
	new) cmd_new "$@" ;;
	build|compile) cmd_build "$@" ;;
	upload|flash) cmd_upload "$@" ;;
	monitor|serial) cmd_monitor "$@" ;;
	setup|install) cmd_setup "$@" ;;
	fqbn|listall) cmd_fqbn "$@" ;;
	ide) exec arduino-ide "$@" ;;
	-h|--help|help) usage ;;
	*) usage; exit 1 ;;
esac
