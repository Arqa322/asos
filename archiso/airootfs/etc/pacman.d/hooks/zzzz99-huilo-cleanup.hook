# Remove build-time hooks from the final image
[Trigger]
Operation = Install
Type = Package
Target = *

[Action]
Description = Removing Huilo build-time pacman hooks...
When = PostTransaction
Exec = /usr/bin/rm -f /etc/pacman.d/hooks/40-huilo-locale-gen.hook /etc/pacman.d/hooks/zzzz99-huilo-cleanup.hook
