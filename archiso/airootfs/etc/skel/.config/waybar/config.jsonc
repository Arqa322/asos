{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 6,
    "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [
        "custom/health",
        "custom/zapret",
        "hyprland/language",
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "temperature",
        "battery",
        "tray",
        "custom/power"
    ],

    "custom/launcher": {
        "format": "  ",
        "tooltip": false,
        "on-click": "wofi --show drun"
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
    },
    "hyprland/window": { "max-length": 50, "separate-outputs": true },
    "hyprland/language": { "format": "{short}" },
    "clock": {
        "format": "{:%H:%M  %a %d.%m}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "locale": "ru_RU.UTF-8"
    },
    "custom/health": {
        "exec": "huilo-logwatch status",
        "return-type": "json",
        "interval": 30,
        "signal": 9,
        "format": "{}",
        "on-click": "kitty --title huilo-logwatch -e sh -c 'huilo-logwatch show; read -rp Enter _'",
        "on-click-right": "huilo-logwatch ack",
        "on-click-middle": "kitty --title huilo-logs -e sh -c 'huilo-logs; read -rp Enter _'"
    },
    "custom/zapret": {
        "exec": "huilo-zapret waybar",
        "return-type": "json",
        "interval": 5,
        "format": "{} zapret",
        "on-click": "kitty --title huilo-zapret -e huilo-zapret menu",
        "on-click-right": "sudo -n huilo-zapret toggle || kitty -e sudo huilo-zapret toggle"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 mute",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "pavucontrol",
        "on-click-middle": "huilo-eq",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤭 offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr} via {gwaddr}",
        "on-click": "kitty -e nmtui"
    },
    "cpu": { "format": " {usage}%", "interval": 3, "on-click": "kitty -e btop" },
    "memory": { "format": " {percentage}%", "interval": 5 },
    "temperature": { "critical-threshold": 85, "format": " {temperatureC}°C" },
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },
    "tray": { "spacing": 8 },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "huilo-power"
    }
}
